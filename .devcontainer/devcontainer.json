{
  "name": "pickonmino_solve",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/starship:1": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {
      "shellautocompletion": true
    },
    "ghcr.io/meaningful-ooo/devcontainer-features/fish:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "minimal"
    },
    "ghcr.io/devcontainers/features/common-utils:1": {
      "configureZshAsDefaultShell": true
    }
  },
  "initializeCommand": {
    "ensure ssh exists": "mkdir -p ~/.ssh",
    "create permanent fish history": "mkdir -p ~/.devcontainer/${devcontainerId} && touch ~/.devcontainer/${devcontainerId}/fish_history"
  },
  "onCreateCommand": {
    "prepare config dirs": "mkdir -p ~/.config/fish",
    "install prek": "uv tool install prek"
  },
  "updateContentCommand": {
    "prek install": "prek install",
    "prek install-hooks": "prek install-hooks"
  },
  "postCreateCommand": {
    "setup user workspace": "bash .devcontainer/config-files.sh",
    "link codex": "mkdir -p ~/.local/bin && ln -sf ~/.codex/packages/standalone/current/bin/codex ~/.local/bin/codex"
  },
  "containerEnv": {
    "PATH": "/home/vscode/.local/bin:${localEnv:PATH}",
    "CODEX_HOME": "/home/vscode/.codex",
    // Docker
    "DOCKER_CONFIG": "/home/vscode/.docker-container"
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.codex",
      "target": "/home/vscode/.codex",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.ssh",
      "target": "/home/vscode/.ssh",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.devcontainer/${devcontainerId}/fish_history",
      "target": "/home/vscode/.local/share/fish/fish_history",
      "type": "bind"
    }
  ],
  // Use 'postCreateCommand' to run commands after the container is created.
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish",
        "editor.semanticHighlighting.enabled": true,
        "editor.inlayHints.enabled": "on",
        "rust-analyzer.check.command": "clippy", // Use clippy instead of 'cargo check' for better lints
        "rust-analyzer.cargo.buildScripts.enable": true,
        "rust-analyzer.procMacro.enable": true, // Essential for crates like serde or tokio
        "rust-analyzer.completion.autoimport.enable": true,
        "rust-analyzer.testExplorer.enable": true,
        "testing.autoRun.mode": "allInWorkspace",
        "cSpell.customDictionaries": {
          "custom-dictionary-workspace": {
            "name": "custom-dictionary-workspace",
            "path": "${workspaceFolder}/.devcontainer/spell-check-dictionary-workspace.txt",
            "addWords": true,
            "scope": "workspace"
          }
        }
      },
      "extensions": [
        "tamasfe.even-better-toml",
        "yzhang.markdown-all-in-one",
        "streetsidesoftware.code-spell-checker",
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb"
      ]
    }
  },
  "remoteUser": "vscode"
}
